# =============================================================================
# Synkra — Environment Variables (.env.example)
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями ваших локальных
# экземпляров сервисов. Никогда не коммитьте файл .env с секретами.
#
# Copy this file to .env and fill in the real values of your local instances.
# Never commit a .env file containing secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Synkra services (required for local agentic development)
# -----------------------------------------------------------------------------

# PostgreSQL — golden object store, Temporal persistence (if used), metadata
POSTGRES_USER=synkra
POSTGRES_PASSWORD=synkra
POSTGRES_DB=synkra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full connection string (preferred by most libraries)
DATABASE_URL=postgresql://synkra:synkra@localhost:5432/synkra

# Temporal — deterministic workflows, conflict resolution, HITL
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# Optional: TEMPORAL_TLS_CERT / TEMPORAL_TLS_KEY if mTLS is enabled

# Redis — caching, queues, short-lived state (optional but recommended)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
LOG_LEVEL=INFO
APP_ENV=development                    # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# 2. Atlassian suite (Jira + Confluence + Crowd) — local instances
# -----------------------------------------------------------------------------
# These are used for conflict stewardship (Jira), knowledge/docs (Confluence),
# and identity/SSO (Crowd).

# --- Jira (required for conflict resolution workflows) ---
# Purpose: create and track data-conflict issues, receive resolution Signals
JIRA_URL=http://localhost:8080          # example: http://jira.local:8080 or https://jira.company.local
JIRA_BASE_URL=${JIRA_URL}               # alias used by some clients
JIRA_EMAIL=admin@example.com            # or username for Server/Data Center
JIRA_USERNAME=admin                     # for Server/Data Center basic auth
JIRA_API_TOKEN=                         # preferred for Cloud / personal access token
JIRA_PASSWORD=                          # only if API token is not used (Server)
JIRA_PROJECT_KEY=DATA                   # dedicated project for Synkra conflicts
JIRA_ISSUE_TYPE=Task                    # or Bug / Story / custom "Data Conflict"
JIRA_BOARD_ID=                          # optional, for board links
# Webhook secret for incoming status-change webhooks (Temporal Signal source)
JIRA_WEBHOOK_SECRET=

# --- Confluence (knowledge base, runbooks, ontology documentation) ---
# Purpose: store and retrieve runbooks, architecture docs, data dictionary
CONFLUENCE_URL=http://localhost:8090    # example: http://confluence.local:8090
CONFLUENCE_BASE_URL=${CONFLUENCE_URL}
CONFLUENCE_USERNAME=admin
CONFLUENCE_EMAIL=admin@example.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_PASSWORD=
CONFLUENCE_SPACE_KEY=SYNKRA              # space where Synkra docs live
CONFLUENCE_PARENT_PAGE_ID=              # optional root page for auto-generated docs

# --- Crowd (Atlassian identity / SSO / user directory) ---
# Purpose: central authentication, user/group lookup, future SSO for Synkra UI
CROWD_URL=http://localhost:8095         # example: http://crowd.local:8095
CROWD_BASE_URL=${CROWD_URL}
CROWD_APPLICATION_NAME=synkra            # application name registered in Crowd
CROWD_APPLICATION_PASSWORD=              # application password from Crowd admin
CROWD_USERNAME=                          # optional service account
CROWD_PASSWORD=
# Validation / session settings (optional)
CROWD_VALIDATION_INTERVAL=1800
CROWD_SESSION_LASTVALIDATION=1800

# -----------------------------------------------------------------------------
# 3. Bitbucket (Git hosting — alternative or complement to GitHub)
# -----------------------------------------------------------------------------
# Purpose: source control, PRs, webhooks for CI triggers, possible mirror of synkra
BITBUCKET_URL=http://localhost:7990     # Bitbucket Server / Data Center base URL
BITBUCKET_BASE_URL=${BITBUCKET_URL}
BITBUCKET_USERNAME=admin
BITBUCKET_PASSWORD=                     # or HTTP access token / app password
BITBUCKET_API_TOKEN=
BITBUCKET_PROJECT_KEY=SYNK              # project key that contains the repos
BITBUCKET_REPO_SLUG=synkra              # repository slug
BITBUCKET_WEBHOOK_SECRET=               # for incoming push / PR webhooks
# SSH (optional, for agent git operations)
BITBUCKET_SSH_HOST=localhost
BITBUCKET_SSH_PORT=7999
BITBUCKET_SSH_USER=git

# -----------------------------------------------------------------------------
# 4. Jenkins (CI/CD)
# -----------------------------------------------------------------------------
# Purpose: alternative or complementary CI/CD pipelines, job triggers from agents,
# release builds, promotion to production-like environments
JENKINS_URL=http://localhost:8081       # example: http://jenkins.local:8080
JENKINS_BASE_URL=${JENKINS_URL}
JENKINS_USERNAME=admin
JENKINS_PASSWORD=                       # or API token (preferred)
JENKINS_API_TOKEN=                      # create in Jenkins user → Configure → API Token
JENKINS_JOB_PREFIX=synkra               # optional prefix for jobs created by agents
# CSRF crumb (Jenkins often requires it for remote API calls)
JENKINS_CRUMB_ISSUER_ENABLED=true
# Folder / view where Synkra pipelines live (optional)
JENKINS_FOLDER=Synkra

# -----------------------------------------------------------------------------
# 5. Optional / future integrations
# -----------------------------------------------------------------------------

# OpenMetadata (catalog) — if self-hosted
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=

# Generic SMTP / notifications (alerts about conflicts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=synkra@example.com
ALERT_EMAIL_TO=

# Slack / Teams webhooks (optional alerting)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Notes for autonomous agents
# -----------------------------------------------------------------------------
# 1. Prefer API tokens over passwords wherever possible.
# 2. All *_URL variables should be reachable from the Docker network or host
#    where workers run (use host.docker.internal if containers need to talk
#    to services on the host).
# 3. For Jira conflict workflow the minimum required set is:
#    JIRA_URL, JIRA_USERNAME or JIRA_EMAIL + JIRA_API_TOKEN/PASSWORD,
#    JIRA_PROJECT_KEY.
# 4. Crowd is optional for Phase 1; required when Synkra UI gains login.
# 5. Bitbucket and Jenkins are optional if you stay on GitHub Actions only;
#    they become valuable for full local enterprise-like delivery loops.
# 6. After changing .env always restart the affected services:
#    docker compose up -d --force-recreate
