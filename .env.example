# Synkra local development environment
# Copy to .env and adjust values

# PostgreSQL
POSTGRES_USER=synkra
POSTGRES_PASSWORD=synkra
POSTGRES_DB=synkra
DATABASE_URL=postgresql://synkra:synkra@localhost:5432/synkra

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Redis
REDIS_URL=redis://localhost:6379/0

# Jira (for conflict resolution)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DATA

# Optional
LOG_LEVEL=INFO
