# =============================================================================
# Synkra — Environment Variables Example
# =============================================================================
# Скопируйте этот файл в `.env` и заполните реальными значениями.
# Copy this file to `.env` and fill in real values for your local instances.
#
# Все переменные сгруппированы по системам. Для каждой указано:
# - Назначение (Purpose)
# - Пример значения (Example)
# - Required / Optional для Phase 1
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Database & Runtime (REQUIRED for Phase 1)
# -----------------------------------------------------------------------------

# PostgreSQL — основной store для golden objects, provenance, mappings
# Purpose: Primary database for GoldenObject, AttributeHistory, Provenance
POSTGRES_USER=synkra
POSTGRES_PASSWORD=synkra
POSTGRES_DB=synkra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full connection string (preferred by most libraries)
DATABASE_URL=postgresql://synkra:synkra@localhost:5432/synkra

# Temporal — deterministic workflows + HITL (Jira Signals)
# Purpose: Orchestration of conflict detection, mapping, long-running processes
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# Optional: TEMPORAL_TLS_CERT / TEMPORAL_TLS_KEY if using mTLS later

# Redis — caching, rate-limiting, short-lived state
# Purpose: Optional but recommended for connector workers and mapping cache
REDIS_URL=redis://localhost:6379/0

# Application
LOG_LEVEL=INFO
ENVIRONMENT=local          # local | staging | production
APP_NAME=synkra

# -----------------------------------------------------------------------------
# 2. Jira (REQUIRED for Conflict Resolution — Phase 1)
# -----------------------------------------------------------------------------
# Purpose: Создание задач при обнаружении конфликтов данных,
#          bi-directional status sync через Temporal Signals / webhooks.
# Local instance example: http://jira.local:8080  or  https://jira.yourcompany.local

JIRA_URL=http://localhost:8080
# or https://jira.your-local-domain

# Authentication (choose one method)
# Method A: Basic / PAT (recommended for local)
JIRA_EMAIL=admin@example.com          # or username
JIRA_API_TOKEN=your-jira-api-token-or-password

# Method B: Personal Access Token only (some local setups)
# JIRA_PAT=

# Project where conflict tasks will be created
JIRA_PROJECT_KEY=DATA                 # Example: DATA, SYN, CONFLICTS

# Optional advanced
JIRA_ISSUE_TYPE=Task                  # or Bug / Story / custom
JIRA_WEBHOOK_SECRET=                  # for verifying incoming webhooks from Jira
JIRA_DEFAULT_ASSIGNEE=                # accountId or username of default steward

# -----------------------------------------------------------------------------
# 3. Confluence (Optional — documentation, runbooks, ontology docs)
# -----------------------------------------------------------------------------
# Purpose: Хранение runbooks, architecture decisions, ontology descriptions,
#          публикация отчётов о конфликтах / mapping decisions.
# Local instance example: http://confluence.local:8090

CONFLUENCE_URL=http://localhost:8090
CONFLUENCE_EMAIL=admin@example.com
CONFLUENCE_API_TOKEN=your-confluence-token-or-password
CONFLUENCE_SPACE_KEY=SYNKRA           # Space where Synkra docs will live
CONFLUENCE_PARENT_PAGE_ID=            # Optional: parent page ID for auto-created pages

# -----------------------------------------------------------------------------
# 4. Crowd (Atlassian Crowd — Identity & SSO)
# -----------------------------------------------------------------------------
# Purpose: Централизованная аутентификация / авторизация для Synkra UI и API,
#          синхронизация пользователей и групп (data stewards, admins).
# Local instance example: http://crowd.local:8095/crowd

CROWD_URL=http://localhost:8095/crowd
CROWD_APPLICATION_NAME=synkra
CROWD_APPLICATION_PASSWORD=your-crowd-app-password
# Optional
CROWD_VALIDATION_INTERVAL=30          # seconds
CROWD_SESSION_LASTVALIDATION=         # internal

# -----------------------------------------------------------------------------
# 5. Bitbucket (Source control / Git hosting)
# -----------------------------------------------------------------------------
# Purpose: Альтернатива / дополнение к GitHub. CI hooks, webhooks,
#          хранение connector configs, GitOps manifests если используется.
# Local instance example: http://bitbucket.local:7990

BITBUCKET_URL=http://localhost:7990
BITBUCKET_USERNAME=admin
BITBUCKET_APP_PASSWORD=your-bitbucket-app-password   # or personal access token
BITBUCKET_PROJECT_KEY=SYNK            # Project key
BITBUCKET_REPO_SLUG=synkra            # Repository slug
# Optional webhook secret for incoming events
BITBUCKET_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 6. Jenkins (CI / CD)
# -----------------------------------------------------------------------------
# Purpose: Запуск pipeline'ов (альтернатива или дополнение к GitHub Actions),
#          сборка Docker-образов, деплой, запуск Temporal workers / tests.
# Local instance example: http://jenkins.local:8080

JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=your-jenkins-api-token   # from user configure → API Token
# Optional
JENKINS_JOB_PREFIX=synkra-                # prefix for jobs created by agents
JENKINS_CRUMB_ISSUER=true                 # CSRF protection on local Jenkins

# -----------------------------------------------------------------------------
# 7. Future / Optional services (placeholders for later phases)
# -----------------------------------------------------------------------------

# OpenMetadata
# OPENMETADATA_URL=http://localhost:8585
# OPENMETADATA_JWT_TOKEN=

# Neo4j (graph option)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PROMETHEUS_MULTIPROC_DIR=/tmp

# MCP / external agents
# MCP_SERVER_PORT=3000

# =============================================================================
# Notes for agents and developers
# =============================================================================
# 1. Never commit the real `.env` file.
# 2. For local Atlassian stack the most common ports are:
#    Jira 8080, Confluence 8090, Crowd 8095, Bitbucket 7990, Jenkins 8080.
# 3. Phase 1 requires only: Postgres, Temporal, Jira.
# 4. Confluence, Crowd, Bitbucket, Jenkins become useful from Phase 2+.
# 5. When an agent needs a new variable — add it here with full documentation.
# =============================================================================
